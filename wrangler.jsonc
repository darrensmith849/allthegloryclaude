{
  // Cloudflare Workers deployment for the All The Glory album site
  // (full-stack Next.js via OpenNext). https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allthegloryclaude",
  // OpenNext's worker plus a nightly backup job (custom-worker.ts).
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Production custom domains — Cloudflare creates the DNS records + SSL and
  // routes both apex and www to this worker.
  "routes": [
    { "pattern": "alltheglory.co.za", "custom_domain": true },
    { "pattern": "www.alltheglory.co.za", "custom_domain": true }
  ],
  // The 74MB album download lives in R2 (Workers static assets cap at 25MiB
  // per file) and is served directly from its public R2 URL — see
  // downloadZipSrc in src/content/album.ts — so the app worker doesn't need
  // an R2 binding for it.
  // Durable analytics store — page views, album downloads, and donations.
  // Native Cloudflare D1 (SQLite), nothing external to configure.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alltheglory-data",
      "database_id": "6154f7e2-beb7-43ea-9243-8e631b7f45f0"
    }
  ],
  // Workers AI - writes the "For my life" line in the dashboard's word
  // journal (/api/word-fill). 10,000 free neurons a day, about 80 words.
  "ai": {
    "binding": "AI"
  },
  // Private bucket for nightly backups of The Study (never public; see
  // src/lib/study/backup-core.ts). Backups are kept for good.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "alltheglory-backups"
    }
  ],
  // Nightly backup at 02:00 UTC (04:00 in South Africa).
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Secrets (PAYSTACK_SECRET_KEY, ANTHROPIC_API_KEY, etc.) are set with
  // `wrangler secret put <NAME>` or in the dashboard — never committed here.
}
